# Public site URL used for canonical links, sitemap and Open Graph.
# Local: http://127.0.0.1:43129
# Preview/production: the Vercel URL, then the custom domain once connected.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43129

# Optional Formspree / Getform / custom endpoint that accepts JSON POSTs.
# If empty, the contact form falls back to a mailto: link.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Founder content admin (single user). All three are required or /login stays disabled.
# Password must be at least 8 characters. AUTH_SECRET must be at least 16 characters.
# Generate a secret with: openssl rand -base64 32
ADMIN_EMAIL=oli@player29.com
ADMIN_PASSWORD=
AUTH_SECRET=

# Production content store on Vercel. Create a Blob store in the Vercel dashboard
# and paste the token here. When this is set, edits save to Vercel Blob.
# When it is empty, edits save to .data/content.json on the local machine.
# Committed content/default.json is always the fallback if the store is empty.
BLOB_READ_WRITE_TOKEN=
