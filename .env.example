# Public site URL used for canonical links, sitemap and Open Graph.
# Local: http://127.0.0.1:43129
# Preview/production: the Vercel URL, then the custom domain once connected.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43129

# Optional Formspree / Getform / custom endpoint that accepts JSON POSTs.
# If empty, the contact form falls back to a mailto: link.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
